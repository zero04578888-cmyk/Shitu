<?xml version="1.0" encoding="utf-8"?>
<!-- 游戏存档保存在 SharedPreferences 中，随云备份与设备迁移一起转移。 -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="shitu_save_store.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="shitu_save_store.xml" />
    </device-transfer>
</data-extraction-rules>
